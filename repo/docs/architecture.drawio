        <mxCell id="awscloud" value="AWS Cloud — one stack per environment (dev / sit / preprod / prod)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#232F3E;fontStyle=1;fontSize=14;" vertex="1" parent="1">
