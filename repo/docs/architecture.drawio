        <mxCell id="env-prod" value="PROD&#10;&#10;VPC 10.40.0.0/16 · 3 AZ&#10;NAT per AZ&#10;OpenSearch r6g.large ×3&#10;2+ tasks per service&#10;canary 25% → verify → 100%&#10;deletion protection ON" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="240" height="220" as="geometry" />
