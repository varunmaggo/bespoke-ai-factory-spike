        <mxCell id="env-preprod" value="PREPROD&#10;&#10;VPC 10.30.0.0/16 · 3 AZ&#10;NAT per AZ&#10;OpenSearch r6g.large ×2&#10;prod-like task counts&#10;canary deploys&#10;deletion protection ON" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=10;fillColor=#FCE9D8;strokeColor=#D86613;fontSize=12;" vertex="1" parent="1">
