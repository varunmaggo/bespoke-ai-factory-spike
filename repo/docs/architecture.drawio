        <mxCell id="p1" value="smoke tests pass" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="env-dev" target="env-sit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2" value="DAST clean + approval" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="env-sit" target="env-preprod"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3" value="canary verified + approval" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="env-preprod" target="env-prod"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note1" value="Same Terraform stack, four tfvars: infra/terraform/envs/{dev,sit,preprod,prod}.tfvars — state isolated per env in S3 (backend-&lt;env&gt;.hcl). Recommended: separate AWS accounts per env via AWS Organizations; the var file carries the account-specific settings." style="text;html=1;align=left;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="1260" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
