{
  "uid": "fintech-payments",
  "title": "Fintech — Payment Gateway",
  "tags": ["fintech", "payments"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Authorisations vs Declines (per min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(payments_authorised_total[5m])) * 60",
          "legendFormat": "authorised"
        },
        {
          "expr": "sum(rate(payments_declined_total[5m])) * 60",
          "legendFormat": "declined"
        },
        {
          "expr": "sum(rate(payments_acquirer_unavailable_total[5m])) * 60",
          "legendFormat": "acquirer unavailable"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Decline Ratio (10m)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(payments_declined_total[10m])) / clamp_min(sum(rate(payments_authorised_total[10m])) + sum(rate(payments_declined_total[10m])), 1e-9)",
          "legendFormat": "decline ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Acquirer Circuit Breaker",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max(resilience4j_circuitbreaker_state{name=\"acquirer\", state=\"open\"})",
          "legendFormat": "open"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Acquirer Round-trip Latency p50 / p95 / p99 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(payments_acquirer_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(payments_acquirer_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(payments_acquirer_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Authorised Value by Currency (minor units / min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(payments_authorised_amount_total[5m])) by (currency) * 60",
          "legendFormat": "{{currency}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Idempotent Replays (per min) — duplicate submissions absorbed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(payments_idempotent_replays_total[5m])) * 60",
          "legendFormat": "replays"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gateway HTTP p95 by URI (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"payment-gateway\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ]
    }
  ]
}
