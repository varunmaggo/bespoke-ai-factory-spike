{
  "uid": "ai-factory-single-pane",
  "title": "AI Factory — Single Pane of Glass",
  "description": "Unified health view across the whole AI Factory pipeline: edge (Spring API), the five agent stages (retrieve → enrich → transform → generate → validate) and runtime/infra. Span-derived RED metrics come from the OTel Collector spanmetrics connector; Spring metrics from actuator. Links out to Jaeger for traces.",
  "tags": ["ai-factory", "single-pane-of-glass", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    {
      "title": "Traces (Jaeger)",
      "type": "link",
      "icon": "external link",
      "url": "http://localhost:16686",
      "targetBlank": true
    },
    {
      "title": "Detailed Overview",
      "type": "dashboards",
      "tags": ["ai-factory"],
      "asDropdown": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(ai_factory_calls_total, service_name)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health at a glance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Services Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "count(up == 1)", "legendFormat": "up", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets Down",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "count(up == 0) or vector(0)", "legendFormat": "down", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pipeline Throughput (req/s)",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(rate(ai_factory_calls_total[5m])) or vector(0)", "legendFormat": "spans/s", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pipeline Error Rate",
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(rate(ai_factory_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(ai_factory_calls_total[5m])), 1) or vector(0)", "legendFormat": "error %", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Spring API p95 (s)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"spring-service\"}[5m])) by (le))", "legendFormat": "p95", "refId": "A" }
      ]
    },

    {
      "id": 200,
      "type": "row",
      "title": "Agent pipeline — RED by stage  (retrieve → enrich → transform → generate → validate)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Throughput by service / span (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "expr": "sum(rate(ai_factory_calls_total{service_name=~\"$service\"}[5m])) by (service_name, span_name)", "legendFormat": "{{service_name}} · {{span_name}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 span duration by service (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 0 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(ai_factory_duration_milliseconds_bucket{service_name=~\"$service\"}[5m])) by (le, service_name))", "legendFormat": "{{service_name}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error rate by service (% of spans)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(ai_factory_calls_total{service_name=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[5m])) by (service_name) / clamp_min(sum(rate(ai_factory_calls_total{service_name=~\"$service\"}[5m])) by (service_name), 1)", "legendFormat": "{{service_name}}", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Service health (Prometheus targets)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Up" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        { "expr": "up", "legendFormat": "", "refId": "A", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "renameByName": { "Value": "Up", "job": "Job", "instance": "Instance" } } }
      ]
    },

    {
      "id": 300,
      "type": "row",
      "title": "Edge — Spring API (orchestrator)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request rate by route (req/s)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-service\"}[5m])) by (uri)", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 latency by route (s)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"spring-service\"}[5m])) by (le, uri))", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "5xx responses (rate)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60 }, "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring-service\", status=~\"5..\"}[5m])) or vector(0)", "legendFormat": "5xx", "refId": "A" }
      ]
    },

    {
      "id": 400,
      "type": "row",
      "title": "Runtime & infrastructure",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "JVM heap used (bytes)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"spring-service\", area=\"heap\"})", "legendFormat": "heap used", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{job=\"spring-service\", area=\"heap\"})", "legendFormat": "heap max", "refId": "B" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Spring CPU utilisation",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "expr": "process_cpu_usage{job=\"spring-service\"}", "legendFormat": "process", "refId": "A" },
        { "expr": "system_cpu_usage{job=\"spring-service\"}", "legendFormat": "system", "refId": "B" }
      ]
    }
  ]
}
