# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── AWS (required for AWS Transform and OpenSearch Serverless) ────────────────
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Or use a named profile:
# AWS_PROFILE=ai-factory

# ── Optional ──────────────────────────────────────────────────────────────────
# OpenAI (for DeepEval metric models — Anthropic also supported)
OPENAI_API_KEY=

# DeepEval cloud (optional)
DEEPEVAL_API_KEY=

# Neo4j
NEO4J_PASSWORD=changeme

# ── Internal source connectors (optional — sample data used if unset) ─────────
# Confluence (Atlassian REST API: email + API token)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE=

# SharePoint (Microsoft Graph: Azure AD app registration, client-credentials)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# Grafana
GRAFANA_PASSWORD=admin

# Slack (for CD notifications)
SLACK_WEBHOOK_URL=

# AWS account (for CI/CD OIDC roles)
AWS_ACCOUNT_ID=123456789012
