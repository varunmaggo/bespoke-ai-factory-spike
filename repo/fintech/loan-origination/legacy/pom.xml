<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.7.x loan origination.
    BEFORE state for AWS Transform definition: fintech-soap-to-rest.

    Key problems with this code:
      - SOAP credit bureau integration with hand-built XML envelopes and
        regex response parsing — brittle, no schema validation
      - One 100-line decide() method mixing bureau I/O, affordability maths
        and policy thresholds — untestable in isolation
      - Hardcoded credit policy (score cut-offs, DTI limits) — every policy
        change is a release
      - No decision audit trail — regulators ask "why was this declined?"
        and the answer is a log grep
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>loan-origination-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>Loan Origination (Legacy)</name>
  <description>
    Unsecured-loan origination and credit decisioning — legacy SOAP-based
    implementation. To be modernised via AWS Transform (fintech-soap-to-rest).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
