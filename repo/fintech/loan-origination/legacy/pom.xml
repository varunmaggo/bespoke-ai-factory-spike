<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.2.13.RELEASE loan origination.
    CVE profile: CVE-2022-42889 (Text4Shell, commons-text 1.9), CVE-2022-22965 (Spring4Shell).
    BEFORE state for AWS Transform definition: fintech-soap-to-rest.

    Key problems with this code:
      - SOAP credit bureau integration with hand-built XML envelopes and
        regex response parsing — brittle, no schema validation
      - One 100-line decide() method mixing bureau I/O, affordability maths
        and policy thresholds — untestable in isolation
      - Hardcoded credit policy (score cut-offs, DTI limits) — every policy
        change is a release
      - No decision audit trail — regulators ask "why was this declined?"
        and the answer is a log grep
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.2.13.RELEASE</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>loan-origination-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>Loan Origination (Legacy)</name>
  <description>
    Unsecured-loan origination and credit decisioning — legacy SOAP-based
    implementation. To be modernised via AWS Transform (fintech-soap-to-rest).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- VULNERABLE (CVE-2022-42889, "Text4Shell"): Apache Commons Text 1.9
         StringSubstitutor interpolation RCE. Remediated to 1.10.0 by
         fintech-cve-remediation. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.9</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- No spring-boot repackage: legacy modules are the pre-migration reference
       state and are never containerised. The old Boot plugins also cannot
       repackage Java 17 class files. Run tests with: mvn test -->
</project>
