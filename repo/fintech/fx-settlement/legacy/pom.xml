<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.5.14 FX rates & settlement.
    CVE profile: CVE-2020-8908 / CVE-2018-10237 (Guava 24.1-jre). Spring 5.3.x patched for Spring4Shell.
    BEFORE state for AWS Transform definition: fintech-java-spring2-to-spring3.

    Key problems with this code:
      - FX rates in a public static HashMap — unsynchronised reads during
        scheduled writes (data races), shared mutable global state
      - Rates as double — compounding error in cross-rate division
      - @Scheduled RestTemplate polling with Thread.sleep backoff
      - Stale rates served indefinitely when the provider is down, with no
        staleness indicator to callers
      - Single rate provider — no failover
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.5.14</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>fx-settlement-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>FX Settlement (Legacy)</name>
  <description>
    FX rate distribution and conversion for settlement — legacy Spring Boot
    2.x implementation. To be modernised via AWS Transform
    (fintech-java-spring2-to-spring3).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- VULNERABLE (CVE-2020-8908 / CVE-2018-10237): Guava 24.1-jre temp-dir
         information disclosure and unbounded allocation. Remediated to 32.x by
         fintech-cve-remediation. -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>24.1-jre</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- No spring-boot repackage: legacy modules are the pre-migration reference
       state and are never containerised. The old Boot plugins also cannot
       repackage Java 17 class files. Run tests with: mvn test -->
</project>
