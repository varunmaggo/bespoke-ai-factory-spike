<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.7.x FX rates & settlement.
    BEFORE state for AWS Transform definition: fintech-java-spring2-to-spring3.

    Key problems with this code:
      - FX rates in a public static HashMap — unsynchronised reads during
        scheduled writes (data races), shared mutable global state
      - Rates as double — compounding error in cross-rate division
      - @Scheduled RestTemplate polling with Thread.sleep backoff
      - Stale rates served indefinitely when the provider is down, with no
        staleness indicator to callers
      - Single rate provider — no failover
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>fx-settlement-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>FX Settlement (Legacy)</name>
  <description>
    FX rate distribution and conversion for settlement — legacy Spring Boot
    2.x implementation. To be modernised via AWS Transform
    (fintech-java-spring2-to-spring3).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
