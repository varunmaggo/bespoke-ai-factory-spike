<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.7.x double-entry ledger.
    BEFORE state for AWS Transform definition: fintech-java-spring2-to-spring3.

    Key problems with this code:
      - SQL built by string concatenation — injectable, unparameterised
      - Money as double with epsilon comparisons — rounding drift in balances
      - End-of-day batch with Thread.sleep polling — blocks a thread for hours
      - No pagination on account history — loads entire table into memory
      - javax.*, Boot 2.x servlet stack, no tracing
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>ledger-service-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>Ledger Service (Legacy)</name>
  <description>
    Double-entry general ledger — legacy Spring Boot 2.x implementation.
    To be modernised via AWS Transform (fintech-java-spring2-to-spring3).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
