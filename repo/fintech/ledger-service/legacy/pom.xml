<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.1.18.RELEASE double-entry ledger.
    CVE profile: CVE-2022-22965 (Spring4Shell), CVE-2015-7501 (commons-collections 3.2.1).
    BEFORE state for AWS Transform definition: fintech-java-spring2-to-spring3.

    Key problems with this code:
      - SQL built by string concatenation — injectable, unparameterised
      - Money as double with epsilon comparisons — rounding drift in balances
      - End-of-day batch with Thread.sleep polling — blocks a thread for hours
      - No pagination on account history — loads entire table into memory
      - javax.*, Boot 2.x servlet stack, no tracing
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.1.18.RELEASE</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>ledger-service-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>Ledger Service (Legacy)</name>
  <description>
    Double-entry general ledger — legacy Spring Boot 2.x implementation.
    To be modernised via AWS Transform (fintech-java-spring2-to-spring3).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- VULNERABLE (CVE-2015-7501): Apache Commons Collections 3.2.1 unsafe
         deserialization (InvokerTransformer gadget). Remediated to 3.2.2 by
         fintech-cve-remediation. -->
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.1</version>
    </dependency>

    <!-- Boot 2.1 starter-test ships JUnit 4 only; add JUnit 5 explicitly so
         the Jupiter tests run on this oldest baseline. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.8.2</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- No spring-boot repackage: legacy modules are the pre-migration reference
       state and are never containerised. The old Boot plugins also cannot
       repackage Java 17 class files. Run tests with: mvn test -->
</project>
