<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.4.13 fraud detection rule engine.
    CVE profile: CVE-2021-44228 (Log4Shell, log4j-core 2.14.1), CVE-2022-22965 (Spring4Shell).
    BEFORE state for AWS Transform definition: fintech-rules-to-agentic-rag.

    Key problems with this code:
      - Fraud thresholds hardcoded as magic numbers — tuning means a release
      - Rule IDs only, no explanation — disputed declines cannot be justified
      - Velocity state in an in-memory map — resets on deploy, blind across
        instances
      - No feedback loop — confirmed-fraud outcomes never improve the rules

    Target state: kiro/specs/fraud-triage-agent.kiro.yaml — agentic triage
    that retrieves similar historical cases via RAG, reasons over typology
    documents, and emits a cited, eval-gated narrative per alert.
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.4.13</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>fraud-detection-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>Fraud Detection (Legacy)</name>
  <description>
    Card-transaction fraud rule engine — legacy implementation. To be
    modernised via AWS Transform (fintech-rules-to-agentic-rag) into a Kiro
    agentic triage service.
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- VULNERABLE (CVE-2021-44228, "Log4Shell"): Log4j 2.14.1 JNDI lookup
         RCE. Remediated to 2.17.1 (or removed in favour of Logback) by
         fintech-cve-remediation. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
