<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LEGACY SERVICE — Spring Boot 2.7.x card payment gateway.
    BEFORE state for AWS Transform definition: fintech-java-spring2-to-spring3.

    Key problems with this code:
      - RestTemplate to the acquirer — blocking, no connection-pool tuning
      - Hand-rolled retry with Thread.sleep — ties up servlet threads
      - In-memory synchronized HashMap for idempotency — lost on restart
      - Money as double — floating-point rounding on currency amounts
      - javax.* validation (Boot 2.x servlet stack)
      - No circuit breaker, no OTel tracing, no metrics pipeline
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.fintech</groupId>
  <artifactId>payment-gateway-legacy</artifactId>
  <version>1.0.0-LEGACY</version>
  <packaging>jar</packaging>
  <name>Payment Gateway (Legacy)</name>
  <description>
    Card authorisation/capture gateway — legacy Spring Boot 2.x implementation.
    To be modernised via AWS Transform (fintech-java-spring2-to-spring3).
  </description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Basic actuator — health only, no metrics pipeline -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
